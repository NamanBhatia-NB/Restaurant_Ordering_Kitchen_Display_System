# DumHouse Environment Variables Configuration (Names only - Never commit secret values)

# Supabase Public API (Optional for cloud sync; fallback local store operates out-of-the-box)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Privileged Service Role Key (Server-side operations only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
